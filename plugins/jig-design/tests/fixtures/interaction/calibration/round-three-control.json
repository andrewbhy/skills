      "transitions": [
        {
          "from": "selected",
          "input": "left-click end-turn button",
          "to": "ended",
          "device": "mouse",
          "ops": "MPB"
        },
        {
          "from": "selected",
          "input": "e",
          "to": "ended",
          "device": "keyboard",
          "ops": "K"
        }
