      "id": "end-turn-flow",
      "layer": "board",
      "verb": "end-turn",
      "start": "selected",
      "states": [
        {
          "id": "selected",
          "visibleAs": "the chosen unit has a ring and the End turn button lights"
        },
        {
          "id": "ended",
          "terminal": true,
          "back": "selected"
        }
