            "select"
          ],
          "reason": "winded: cannot help",
          "turnsLeft": "one turn left",
          "clear": "clears next turn"
        },
        {
          "id": "selected",
          "terminal": true,
          "back": "idle",
          "visibleAs": "the chosen unit has a ring and the End turn button lights"
        }
      ],
      "transitions": [
        {
          "from": "idle",
          "input": "left-click unit",
          "to": "selected",
          "device": "mouse",
          "ops": "MPB"
        },
        {
          "from": "idle",
          "input": "tab",
          "to": "selected",
          "device": "keyboard",
          "ops": "MK"
        }
      ],
      "invalid": [
        {
          "from": "idle",
          "input": "left-click empty tile",
          "result": "no change, one-line reason"
        },
        {
          "from": "selected",
          "input": "left-click an enemy with nothing selected",
          "result": "reason 'select a unit first'"
        },
        {
          "from": "selected",
          "input": "right-click a downed ally from two tiles away",
          "result": "the menu still opens: Bandage and Drag greyed with the reason"
        }
      ],
      "back": {
        "input": "right-click",
        "to": "idle"
      }
    },
