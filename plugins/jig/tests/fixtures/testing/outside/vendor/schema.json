{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Notebook wire schema 1.0.0",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "state"],
      "properties": { "op": { "const": "list" }, "state": { "enum": ["all", "open"] } }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "items"],
  "properties": {
    "version": { "const": "1.0.0" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "done"],
        "properties": { "id": { "type": "integer" }, "title": { "type": "string" }, "done": { "type": "boolean" } }
      }
    }
  }
}
